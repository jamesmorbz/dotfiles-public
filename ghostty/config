# Ghostty — lives in ~/dev/dotfiles, symlinked to ~/.config/ghostty/config
# Reload with ⌘⇧, after editing. New windows auto-attach tmux (see .zshrc).
working-directory = ~/dev
window-inherit-working-directory = true

# Matches the tmux status bar (Catppuccin Mocha)
theme = Catppuccin Mocha

# ⌘B = tmux prefix (Ghostty sends Ctrl-b), so tmux shortcuts are ⌘B then a key
keybind = cmd+b=text:\x02

# ⌘⌥ arrows move between tmux panes (sends ⌘B + arrow); Ghostty's own splits aren't used
keybind = cmd+alt+arrow_left=text:\x02\x1b[D
keybind = cmd+alt+arrow_right=text:\x02\x1b[C
keybind = cmd+alt+arrow_up=text:\x02\x1b[A
keybind = cmd+alt+arrow_down=text:\x02\x1b[B
